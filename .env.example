# --- App ---
# Must match the IIS application path. next.config.js and lib/api.ts both read it.
NEXT_PUBLIC_BASE_PATH=/dynocard

# --- Mapbox (public token, safe for the browser) ---
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-public-token

# --- MSSQL (lib/mssql.ts) ---
MSSQL_HOST=sql-server-host
MSSQL_PORT=1433
MSSQL_USER=app_user
MSSQL_PASSWORD=change-me
MSSQL_DATABASE=database-name
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false

# --- Postgres (lib/postgres.ts) ---
PG_CONNECTION_STRING=postgres://user:password@host:5432/database

# --- Excel (lib/excel.ts) ---
# Optional: folder holding workbooks, relative to the app root. Defaults to ./db
EXCEL_DATA_DIR=./db

# --- Auth (dev only) ---
# Overrides the detected Windows user when running locally.
AUTH_USER=
