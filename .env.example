# --- App ---
# Must match the IIS application path. next.config.js and lib/api.ts both read it.
NEXT_PUBLIC_BASE_PATH=/als

# --- Mapbox (public token, safe for the browser) ---
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-public-token

# --- SQL Server, Windows auth (lib/mssql.ts; used for XSPOC) ---
# Runs as the Windows account running Node (IIS: the app pool identity). Needs ODBC Driver 18.
SQL_SERVER=VOC-SQL05
SQL_DATABASE=XSPOC
# SQL_DRIVER=ODBC Driver 18 for SQL Server   (optional; this is the default)
SQL_AUTH=windows

# Optional: where the daily 6 AM morning-report snapshots are saved (default ./db/morning-reports)
# MORNING_REPORT_DIR=./db/morning-reports

# --- MSSQL, SQL login (fallback when SQL_AUTH is not "windows") ---
MSSQL_HOST=sql-server-host
MSSQL_PORT=1433
MSSQL_USER=app_user
MSSQL_PASSWORD=change-me
MSSQL_DATABASE=database-name
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false

# --- Postgres (lib/postgres.ts) ---
PG_CONNECTION_STRING=postgres://user:password@host:5432/database

# --- Excel (lib/excel.ts) ---
# Optional: folder holding workbooks, relative to the app root. Defaults to ./db
EXCEL_DATA_DIR=./db

# --- Auth (dev only) ---
# Overrides the detected Windows user when running locally.
AUTH_USER=
