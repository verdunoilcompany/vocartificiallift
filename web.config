<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + iisnode configuration for the Next.js standalone build.
  `npm run build` copies this file and iis/iisnode.js into .next/standalone/,
  which is the folder to deploy as the IIS application at /dynocard.

  Windows Authentication: enable it (and disable Anonymous) on the IIS application in
  IIS Manager. Those sections are usually locked at the server level, so they are not set here.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="iisnode.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Every request goes to Next; it serves /_next/static and /public itself. -->
        <rule name="NextJs" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="iisnode.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".next" />
          <add segment=".env" />
          <add segment="iisnode" />
          <add segment="db" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Promote the Windows Auth server variables to x-iisnode-* request headers (read by lib/auth.ts). -->
    <iisnode
      node_env="production"
      promoteServerVars="AUTH_USER,LOGON_USER,REMOTE_USER"
      loggingEnabled="true"
      devErrorsEnabled="false"
      watchedFiles="web.config;iisnode.js"
    />

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
